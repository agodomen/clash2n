{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["polyfills/*.js!"],
  "project": ["**/*.{js,jsx,ts,tsx,sass,scss}!", "../scripts/**/*.{js,mjs}!"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "ignoreBinaries": ["rustc", "cc"],
  "ignoreDependencies": ["lint-staged"],
  "ignoreIssues": {
    "types/generated/**": ["exports", "types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
