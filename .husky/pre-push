#!/bin/bash

set -e

# Verify upstream exists
if ! git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  echo "No upstream found, skipping checks"
  exit 0
fi

# Frontend checks
echo "▶ Frontend typecheck + lint..."
pnpm --dir front typecheck
pnpm --dir front lint

# Rust checks
echo "▶ Rust clippy..."
cd client && cargo clippy --all-targets --all-features -- -D warnings && cd ..

echo "✅ Pre-push checks passed"
